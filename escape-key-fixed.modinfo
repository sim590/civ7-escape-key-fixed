<?xml version="1.0" encoding="utf-8"?>
<Mod id="escape-key-fixed" version="2.0.0" xmlns="ModInfo">
	<Properties>
		<Name>EscapeKeyFixed</Name>
		<Description>Pressing Escape deselects the current unit instead of opening the pause menu. Provides the unit deselection action that Civilization VII otherwise lacks; in Civilization VI this was done by left-clicking the map. Menus and panels are handled by the game itself.</Description>
		<Authors>simon</Authors>
		<AffectsSavedGames>0</AffectsSavedGames>
	</Properties>
	<Dependencies>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet/>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="escape-ui" scope="game" criteria="always">
			<Actions>
				<UIScripts>
					<Item>ui/escape-key-fixed.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
